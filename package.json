{
  "name": "redline-pr",
  "version": "0.1.0",
  "description": "Read a PR as a plain-English behavioral spec, redline the sentences, and sync the edits back to code with Claude Code.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "redline": "./dist/bin/cli.js",
    "redline-pr": "./dist/bin/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/bin/cli.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "dev:web": "vite",
    "demo": "tsx bin/cli.ts --demo",
    "start": "node dist/bin/cli.js",
    "install-global": "npm run build && npm link",
    "prepare": "npm run build",
    "test": "node --import tsx --test --test-reporter=spec \"test/**/*.test.ts\"",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
